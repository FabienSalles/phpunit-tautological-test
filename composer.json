{
    "name": "conveycode/tautological-test",
    "description": "PHPUnit training — exercices sur les tests tautologiques et anti-patterns",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-pdo_sqlite": "*",
        "doctrine/doctrine-bundle": "^2.12",
        "doctrine/orm": "^3.2",
        "symfony/dotenv": "^7.0",
        "symfony/framework-bundle": "^7.0",
        "symfony/mailer": "^7.0",
        "symfony/mime": "^7.0",
        "symfony/runtime": "^7.0",
        "symfony/serializer": "^7.0",
        "symfony/yaml": "^7.0"
    },
    "require-dev": {
        "phpspec/prophecy": "^1.19",
        "phpspec/prophecy-phpunit": "^2.2",
        "phpunit/phpunit": "^11.0",
        "symfony/browser-kit": "^7.0",
        "symfony/phpunit-bridge": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true,
            "symfony/flex": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "init-db": "@php bin/init-db.php"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.*"
        }
    },
    "minimum-stability": "stable"
}
